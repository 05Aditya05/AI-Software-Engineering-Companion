# AI Service environment configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
BACKEND_URL=http://localhost:3001

# Gemini LLM provider (Phase 4)
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_MS=30000

# Project understanding (Phase 6)
# PROJECT_ROOT=/absolute/path/to/your/project

# PostgreSQL + pgvector (Phase 9.1)
DATABASE_URL=postgresql+asyncpg://companion_user:replace-with-local-password@localhost:5432/companion_db

# Embedding Provider (Phase 9.2)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
