# ============================================================
# AI Software Engineering Companion — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.
# ============================================================

# --- Service Ports ---
# FRONTEND_PORT=3000      # Next.js default
# BACKEND_PORT=3001       # Express backend
# AI_SERVICE_PORT=8000    # FastAPI AI service

# --- Backend ---
PORT=3001
NODE_ENV=development
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=10000
FRONTEND_URL=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# --- AI Service ---
DEBUG=true

# --- LLM Provider (Phase 4 — Gemini) ---
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_MS=30000

# --- Project Understanding (Phase 6) ---
# PROJECT_ROOT=/absolute/path/to/your/project

# --- Vector Storage / Database (Phase 9 — Docker PostgreSQL + pgvector) ---
POSTGRES_DB=companion_db
POSTGRES_USER=companion_user
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql+asyncpg://companion_user:replace-with-local-password@localhost:5432/companion_db

# --- Embedding Model (Phase 9 — Gemini) ---
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSION=768
