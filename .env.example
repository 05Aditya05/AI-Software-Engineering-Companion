# ============================================================
# AI Software Engineering Companion — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.
# ============================================================

# --- Service Ports ---
# FRONTEND_PORT=3000      # Next.js default
# BACKEND_PORT=3001       # Express backend
# AI_SERVICE_PORT=8000    # FastAPI AI service

# --- Backend ---
PORT=3001
NODE_ENV=development
AI_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- AI Service ---
DEBUG=true

# --- LLM Provider (Phase 4) ---
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o

# --- Embedding Provider (Phase 9) ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# --- Database (Phase 9) ---
# DATABASE_URL=postgresql://companion:companion@localhost:5432/ai_companion
